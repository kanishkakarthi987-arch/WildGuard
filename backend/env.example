# Copy to .env and edit. Real environment variables override this file.

# ---- access --------------------------------------------------------------------------------
# Ranger/admin token for the dashboard (simulate, verify alerts, register devices, log incidents).
# Leave empty and the first start creates a random one in data/admin_token.txt.
WILDGUARD_ADMIN_TOKEN=

# Shared secret your LoRaWAN network server sends in the X-Gateway-Key header.
# Empty = POST /api/ingest/lora is switched off.
WILDGUARD_GATEWAY_KEY=

# Comma-separated frontend origins allowed to call the API
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- alerts --------------------------------------------------------------------------------
# dry_run = record the message that would be sent (safe default). fast2sms = send SMS for real.
NOTIFY_PROVIDER=dry_run
FAST2SMS_API_KEY=

# dry_run or twilio. Voice calls go out for Warning and Imminent to subscribers who opted in.
VOICE_PROVIDER=dry_run
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Optional webhook that drives a siren or LED beacon at the village (receives a JSON POST)
BEACON_WEBHOOK_URL=

# ---- camera detection ----------------------------------------------------------------------
# Needs: pip install -r requirements-ml.txt. The default COCO weights know elephants but not
# leopards. Point this at your own fine-tuned weights to detect leopards.
WILDGUARD_MODEL=yolov8n.pt
WILDGUARD_MIN_CONF=0.25

# ---- storage -------------------------------------------------------------------------------
# WILDGUARD_DB=data/wildguard.db
# WILDGUARD_UPLOADS=data/uploads
